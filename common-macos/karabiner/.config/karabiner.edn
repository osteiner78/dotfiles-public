{
    ;; !  | mandatory: the modifier must be held for the rule to match
    ;; #  | optional: the modifier may be held

    ;; :!Ca is keycode :a and prefix a with !C

    ;; C  | left_command
    ;; T  | left_control
    ;; O  | left_option
    ;; S  | left_shift
    ;; F  | fn
    ;; Q  | right_command
    ;; W  | right_control
    ;; E  | right_option
    ;; R  | right_shift
    ;; P  | caps_lock

    ;; ## | optional any
    ;; !! | command + control + option + shift (hyper)

    ;; Goku examples: https://github.com/yqrashawn/GokuRakuJoudo/blob/master/examples.org
    ;; Karabiner JSON reference: https://karabiner-elements.pqrs.org/docs/json/

:profiles {
    :Default {
        :default true
        :sim     50     ;; ms: two keydowns within this time count as simultaneous (only simlayers use it; none defined)
        :delay   500    ;; ms: to_delayed_action timeout (not used)
        :alone   300    ;; ms: a key released within this time with no other key pressed counts as a tap (to_if_alone): caps -> esc, left_command and left_control taps
        :held    500    ;; ms: how long a key must be held before to_if_held_down fires (not used)
    }
}
:devices {:apple-internal [{:vendor_id 1452 :product_id 834}]
        :logitech [{:vendor_id 1133 :product_id 50475}] ;; Logitech MX Keys
        :yk75 [{:vendor_id 1452 :product_id 591}]
}

:templates {
        :launch "open -a %s"
        :launch_new "open -n -a %s"        ; -n: separate process per window (Ghostty)

        ; launch-focus (common-macos/bin): activates the app if it is running, otherwise opens it and waits for it to start
        :focus            "$HOME/dotfiles/common-macos/bin/launch-focus --app \"%s\""
        :focus_bid        "$HOME/dotfiles/common-macos/bin/launch-focus --bundle-id \"%s\""
}

:applications{
        :1password      ["^com\\.1password\\.1password$"]
        :arc            ["^company\\.thebrowser\\.Browser$"]
        :chatgpt        ["^com\\.openai\\.chat$"]
        :claude         ["^com\\.anthropic\\.claudefordesktop"]
        :code           ["^com\\.visualstudio\\.code\\.oss$"
                        "^com\\.microsoft\\.VSCode(Insiders)?$"]
        :finder         ["^com\\.apple\\.finder$"]
        :ghostty        ["^com\\.mitchellh\\.ghostty$"]
        :mail           ["^com\\.apple\\.mail$"]
        :notes          ["^com\\.apple\\.Notes$"]
        :obsidian       ["^md\\.obsidian$"]
        :pdf            ["^com\\.readdle\\.PDFExpert-Mac$"]
        :snippetslab    ["^com\\.renfei\\.SnippetsLab$"]
        :safari         ["^com\\.apple\\.Safari$"]
        :sublime        ["^com\\.sublimetext\\.4$"]
        :things         ["^com\\.culturedcode\\.ThingsMac$"]
        :todoist        ["^com\\.todoist\\.mac\\.Todoist$"]
        :zen            ["^app\\.zen-browser\\.zen$"]
}

;; layers: while the key is held, the variable :hyper-mode is set and rules that list it apply
:layers {:hyper-mode {:key :caps_lock :alone {:key :escape}}    ;; caps_lock is the hyper key, tap = escape
                                                                ;; needs System Settings > Keyboard > Keyboard Shortcuts > Modifier Keys: Caps Lock = No Action
}

:main [
        ;;  ========== HYPER KEY (App launcher) ==================
        {:des "Launch apps with hyperkey"
        :rules [:hyper-mode
                [:1 [:launch "/Applications/1Password.app"]]
                [:a [:focus "Arc"]]
                [:c [:focus "Calendar"]]
                [:d "/usr/bin/shortcuts run \"Toggle Dark Mode\""]
                [:f [:launch "/System/Library/CoreServices/Finder.app"]]  ;; open -a, not activate: opens a window when Finder has none
                [:g [:focus "Gmail"]]
                [:m [:launch "~/Applications/'Google Maps'.app"]]
                ; [:n [:launch "/Applications/SnippetsLab.app"]]
                [:o [:focus "Obsidian"]]
                [:p [:focus "Paperless-ngx"]]
                [:t [:focus "Todoist"]]
                [:q [:launch_new "Ghostty"]]
                [:v [:focus_bid "com.microsoft.VSCode"]]
                [:w [:focus_bid "net.whatsapp.WhatsApp"]]
                [:z [:focus "Claude"]]
                [:x [:focus "Gemini"]]
                [:equal_sign [:launch "/Applications/'Soulver 3'.app"]]]}

        ;;  ========== HYPER KEY (Quality of life) ==================
        {:des "Screenshots with hyperkey"
        :rules [:hyper-mode
                [:4 :!CS4]
                [:5 :!CS5]
                ]}

        {:des "Page Up/Page Down with hyperkey"
        :rules [:hyper-mode
                [:down_arrow :page_down]
                [:up_arrow :page_up]
                [:j :page_down]
                [:k :page_up]
                ]}

        {:des "Hyper+S: Universal sidebar toggle"
        :rules [:hyper-mode
                [:s :!CSd :1password]
                [:s :!Cs  :arc]
                [:s :!CTs :chatgpt]
                [:s :!Cperiod  :claude]
                [:s :!Cb  :code]
                [:s :!CTs :finder]
                [:s :!CTs :mail]
                [:s :!COs :notes]
                [:s :!TSs :obsidian]
                [:s :!CSl :safari]
                [:s :!CO0 :pdf]
                [:s :!SCl :snippetslab]
                [:s [:!Ck :!Cb] :sublime]
                [:s :!Cslash :things]
                [:s :m :todoist]
                [:s :!COc :zen]
                [:s :!Cb] ;; fallback for all other apps
                ]}

        {:des "Hyper+space: Universal command palette"
        :rules [:hyper-mode
                [:spacebar :!Cl :arc]
                [:spacebar :!Cp :obsidian]
                [:spacebar :!Ck :claude]
                [:spacebar :!CSp :code]
                [:spacebar :!CSp :ghostty]
                [:spacebar :!CSp :sublime]
                [:spacebar :!Cf :things]
                [:spacebar :!Ck :todoist]
                ]}

        {:des "Hyper: Arc Browser (l: Little Arc - u: copy URL as markdown - \\: Reopen last closed tab)"
        :rules [:hyper-mode
                [:##grave_accent_and_tilde :!CTOp :arc]
                [:##l :!COn :arc]
                [:##u :!COSc :arc]
                [:##backslash :!CSt :arc]
                ]}

        {:des "Cheatsheet (Hyper + ?)"
        :rules [:hyper-mode
                [:##slash "$HOME/dotfiles/common-macos/bin/show-karabiner-cheatsheet"]
                ]}

        {:des "Hyper+B: Toggle jankyborders"
        :rules [:hyper-mode
                [:b "$HOME/.local/bin/borders-ctl toggle"]
                ]}

        ;;  ========== KEYBOARD MODIFICATIONS (external keyboards) ==================
        ;; Home/End/PgUp/PgDn shortcuts are used with the right hand only, hence the right-side modifiers
        {:des "Home and End keys (external keyboards)"
        :rules [
                [:home :!Cleft_arrow]
                [:end :!Cright_arrow]
                [:!Rhome :!CRleft_arrow]
                [:!Rend :!CRright_arrow]
                ]}

        {:des "Next/Previous tab (on 100% keyboard)"
        :rules [
                [:!Epage_up :!QRopen_bracket]
                [:!Epage_down :!QRclose_bracket]
                ]}

        {:des "Next/Previous tab (on YK75)"
        :rules [:yk75
                [:!Wpage_up :!QRopen_bracket]
                [:!Wpage_down :!QRclose_bracket]
                ]}

        ;;  ========== TAP TO TOGGLE ==================
        {:des "left_command alone -> ⌘ + tab to last app"
         :rules [[:left_command :left_command nil
         {:alone :!Ctab}
        ]]}

        {:des "In Arc/Code/Zen/Safari/Obsidian/Ghostty: left_control alone -> ctrl + tab to last tab"
        :rules [
                [:left_control :left_control :arc {:alone :!Ttab}]
                [:left_control :left_control :code {:alone :!Ttab}]
                [:left_control :left_control :zen {:alone :!Ttab}]
                [:left_control :left_control :safari {:alone :!Ttab}]
                [:left_control :left_control :obsidian {:alone :!Ttab}]
                [:left_control :left_control :ghostty {:alone :!Ttab}]
                ]}

]}
