<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>xyz.osteiner.scan-intake</string>
    <key>ProgramArguments</key>
    <array>
        <string>@SCRIPT@</string>
        <string>--once</string>
    </array>
    <key>WatchPaths</key>
    <array>
        <string>@HOME@/Scans/outbox</string>
    </array>
    <key>StartInterval</key>
    <integer>900</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>@LOG@</string>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
