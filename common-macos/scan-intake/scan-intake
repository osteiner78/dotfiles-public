#!/usr/bin/env bash
# Uploads scans from ~/Scans/outbox to paperless-ngx. See README.md.
# Targets macOS: BSD tools, and /usr/bin/env bash is bash 3.2 under launchd.

set -euo pipefail

PAPERLESS_TOKEN=
PAPERLESS_URL=https://paperless.osteiner.xyz
SCAN_ROOT=$HOME/Scans
API_VERSION=9
POLL_TIMEOUT=300
POLL_INTERVAL=5
STABLE_SECS=5
DONE_RETENTION_DAYS=180
NOTIFY_SUCCESS=true
LAN_FALLBACK_URL=

ENV_FILE=$HOME/.config/scan-intake/.env
LOG=$HOME/Library/Logs/scan-intake.log
FOLDERS="outbox pending done duplicates failed"

MODE=once
DRY_RUN=false
VERBOSE=false
CONFIG_ERR=
TMP_BODY=
N_SUB=()
N_BODY=()
N_ERR=()
N_URL=()
NOTIFY_SEQ=0
N_OK=0
N_DUP=0
N_FAIL=0
N_WAITING=0
LOCK_HELD=false
AGENT_LABEL=xyz.osteiner.scan-intake

log() { # LEVEL event [key=value...]
    local level=$1 event=$2
    shift 2
    mkdir -p "${LOG%/*}"
    printf '%s %-5s %s%s\n' "$(date +%Y-%m-%dT%H:%M:%S%z)" "$level" "$event" "${*:+ $*}" >>"$LOG"
}

debug() {
    [[ $VERBOSE == true ]] || return 0
    log DEBUG "$@"
}

notify() { # subtitle body [error] [click-url]
    local sub=$1 body=$2 url=${4:-} sound='' tn=()
    local bs=$'\\' q='"'
    NOTIFY_SEQ=$((NOTIFY_SEQ + 1))
    if command -v terminal-notifier >/dev/null 2>&1; then
        local msg=$body
        # terminal-notifier refuses a -message starting with these; the backslash isn't shown.
        case $msg in [-\"\(\[\{]*) msg=$bs$msg ;; esac
        tn=(-title "Scan intake" -subtitle "$sub" -message "$msg")
        [[ ${3:-} == error ]] && tn+=(-sound Basso)
        [[ -n $url ]] && tn+=(-open "$url")
        tn+=(-group "scan-intake-$$-$NOTIFY_SEQ")
        if terminal-notifier "${tn[@]}" >/dev/null 2>&1; then return 0; fi
    fi
    sub=${sub//$bs/$bs$bs}
    sub=${sub//$q/$bs$q}
    body=${body//$bs/$bs$bs}
    body=${body//$q/$bs$q}
    [[ ${3:-} == error ]] && sound=' sound name "Basso"'
    osascript -e "display notification \"$body\" with title \"Scan intake\" subtitle \"$sub\"$sound" >/dev/null 2>&1 || true
}

queue_notify() { # subtitle body [error] [click-url]
    N_SUB+=("$1")
    N_BODY+=("$2")
    N_ERR+=("${3:-}")
    N_URL+=("${4:-}")
}

failed_url() {
    printf 'file://%s/failed/' "$SCAN_ROOT"
}

doc_url() { # id
    printf '%s/documents/%s/details' "$PAPERLESS_URL" "$1"
}

plural() { # count word
    if (($1 == 1)); then echo "$1 $2"; else echo "$1 $2s"; fi
}

flush_notifications() {
    local i n=${#N_SUB[@]} parts=() summary
    ((n > 0)) || return 0
    if ((n <= 5)); then
        for ((i = 0; i < n; i++)); do
            notify "${N_SUB[$i]}" "${N_BODY[$i]}" "${N_ERR[$i]}" "${N_URL[$i]}"
        done
        return 0
    fi
    ((N_OK == 0)) || parts+=("$(plural "$N_OK" scan) uploaded")
    ((N_DUP == 0)) || parts+=("$(plural "$N_DUP" duplicate) skipped")
    ((N_FAIL == 0)) || parts+=("$(plural "$N_FAIL" error)")
    summary=$(printf '%s, ' "${parts[@]}")
    if ((N_FAIL > 0)); then
        notify "Summary" "${summary%, }" error "$(failed_url)"
    else
        notify "Summary" "${summary%, }" "" "$PAPERLESS_URL"
    fi
}

load_env() {
    local line key val mode
    if [[ ! -f $ENV_FILE ]]; then
        CONFIG_ERR="$ENV_FILE is missing; run install.sh"
        return 1
    fi
    mode=$(stat -f %Lp "$ENV_FILE")
    if (((8#$mode & 8#077) != 0)); then
        CONFIG_ERR="$ENV_FILE is mode $mode; fix with: chmod 600 ~/.config/scan-intake/.env"
        return 1
    fi
    while IFS= read -r line || [[ -n $line ]]; do
        line=${line%$'\r'}
        line=${line#"${line%%[![:space:]]*}"}
        case $line in '' | '#'*) continue ;; esac
        [[ $line == *=* ]] || continue
        key=${line%%=*}
        val=${line#*=}
        case $key in
            PAPERLESS_TOKEN | PAPERLESS_URL | SCAN_ROOT | API_VERSION | POLL_TIMEOUT | POLL_INTERVAL | \
                STABLE_SECS | DONE_RETENTION_DAYS | NOTIFY_SUCCESS | LAN_FALLBACK_URL)
                printf -v "$key" '%s' "$val"
                ;;
        esac
    done <"$ENV_FILE"
    PAPERLESS_URL=${PAPERLESS_URL%/}
    if [[ -z $PAPERLESS_TOKEN ]]; then
        CONFIG_ERR="PAPERLESS_TOKEN is empty in $ENV_FILE"
        return 1
    fi
}

check_api_version() {
    [[ $API_VERSION == 9 ]] && return 0
    CONFIG_ERR="API_VERSION must be 9 (is $API_VERSION); the task API changed in version 10"
    return 1
}

config_error() {
    log ERROR config_error "reason=\"$CONFIG_ERR\""
    notify "Config error" "$CONFIG_ERR" error "file://$LOG"
}

ensure_dirs() {
    local d
    for d in $FOLDERS; do
        mkdir -p "$SCAN_ROOT/$d"
    done
}

lower_ext() { # name
    printf '%s' "${1##*.}" | tr '[:upper:]' '[:lower:]'
}

is_scan_file() { # path
    local path=$1 name
    [[ -f $path ]] || return 1
    name=${path##*/}
    [[ $name != .* && $name == *.* ]] || return 1
    case $(lower_ext "$name") in pdf | jpg | jpeg | png | tif | tiff) return 0 ;; esac
    return 1
}

count_outbox() {
    local f n=0
    for f in "$SCAN_ROOT"/outbox/*; do
        if is_scan_file "$f"; then n=$((n + 1)); fi
    done
    echo "$n"
}

count_pending() {
    local f n=0
    for f in "$SCAN_ROOT"/pending/*.task; do
        if [[ -f $f ]]; then n=$((n + 1)); fi
    done
    echo "$n"
}

# api_get and upload discard curl's stderr: launchd appends stderr to the log, and
# the callers log the exit code and HTTP status as proper lines instead.
api_get() { # base-url path -> HTTP_CODE, TMP_BODY; returns curl's exit code
    local rc=0
    HTTP_CODE=$(printf 'Authorization: Token %s\nAccept: application/json; version=%s\n' "$PAPERLESS_TOKEN" "$API_VERSION" |
        curl -sS --connect-timeout 10 --max-time 30 -o "$TMP_BODY" -w '%{http_code}' -H @- "$1$2" 2>/dev/null) || rc=$?
    return "$rc"
}

is_stable() { # path
    local before after
    before=$(stat -f '%z %m' "$1" 2>/dev/null) || return 1
    if ((STABLE_SECS > 0)); then sleep "$STABLE_SECS"; fi
    after=$(stat -f '%z %m' "$1" 2>/dev/null) || return 1
    [[ $before == "$after" ]]
}

file_into() { # path subdir -> sets DEST (never overwrites an existing file)
    local path=$1 name=${1##*/}
    DEST=$SCAN_ROOT/$2/$name
    if [[ -e $DEST ]]; then
        DEST=$SCAN_ROOT/$2/$(date +%s)-$name
    fi
    mv "$path" "$DEST"
}

form_quote() { # value -> value with \ and " escaped, for a quoted curl -F field
    local bs=$'\\' q='"' s=$1
    s=${s//$bs/$bs$bs}
    printf '%s' "${s//$q/$bs$q}"
}

trim_title_punct() { # string -> string without leading/trailing space and -_.,;:
    local s=$1
    while [[ $s == [\ _.,\;:-]* ]]; do s=${s#?}; done
    while [[ $s == *[\ _.,\;:-] ]]; do s=${s%?}; done
    printf '%s' "$s"
}

# launchd runs without LANG, so ${#s} would count bytes and the cut could split a
# multi-byte character; the subshell keeps the locale change local.
scan_title() { # file-name -> title
    (
        LC_ALL=en_US.UTF-8
        local s=${1%.*} head
        local prefix_re='^[0-9]{8}_(.*)$'
        if [[ $s =~ $prefix_re ]]; then s=${BASH_REMATCH[1]}; fi
        set -f
        IFS=$' \t\n'
        # shellcheck disable=SC2086 # word splitting collapses runs of whitespace
        set -- $s
        s=$*
        s=$(trim_title_punct "$s")
        if [[ $s =~ ^[0-9]*$ ]]; then
            date '+Scan %Y-%m-%d %H.%M'
            exit 0
        fi
        if ((${#s} > 80)); then
            head=${s:0:80}
            if [[ ${s:80:1} != ' ' && $head == *' '* ]]; then head=${head% *}; fi
            s=$(trim_title_punct "$head")
        fi
        printf '%s' "$s"
    )
}

upload() { # path base-url -> HTTP_CODE, TMP_BODY; returns curl's exit code
    local path=$1 name=${1##*/} rc=0
    local dated_re='^[0-9]{4}-[0-9]{2}-[0-9]{2} - .+'
    local doc title form=()
    # Unquoted, curl splits -F values on ';' and ',' and fails with exit 26.
    doc="document=@\"$(form_quote "$path")\""
    if [[ $name =~ $dated_re ]]; then
        form=(-F "$doc;filename=\"$(form_quote "$name")\"" -F "created=${name:0:10}")
    else
        title=$(scan_title "$name")
        # Same rule as the document path: curl splits an unquoted value on ';' and ',',
        # and reads the file named by an unquoted value starting with '<' or '@'.
        if [[ $title == *[\\\"\;,]* || $title == [\<@]* ]]; then title="\"$(form_quote "$title")\""; fi
        form=(-F "$doc;filename=scan.$(lower_ext "$name")" -F "title=$title")
    fi
    HTTP_CODE=$(printf 'Authorization: Token %s\nAccept: application/json; version=%s\n' "$PAPERLESS_TOKEN" "$API_VERSION" |
        curl -sS --fail-with-body --connect-timeout 10 --max-time 600 -o "$TMP_BODY" -w '%{http_code}' -H @- \
            "${form[@]}" "$2/api/documents/post_document/" 2>/dev/null) || rc=$?
    return "$rc"
}

# Polls until the task is final or POLL_TIMEOUT passes. Sets TASK_STATUS.
poll_task() { # uuid base-url
    local start=$SECONDS
    TASK_STATUS=
    while :; do
        if api_get "$2" "/api/tasks/?task_id=$1" && [[ $HTTP_CODE == 200 ]]; then
            TASK_STATUS=$(jq -r '.[0].status // empty' <"$TMP_BODY" 2>/dev/null || true)
            debug poll_attempt "task=$1 status=${TASK_STATUS:-none}"
            case $TASK_STATUS in SUCCESS | FAILURE) return 0 ;; esac
        else
            debug poll_attempt "task=$1 http=${HTTP_CODE:-none}"
        fi
        ((SECONDS - start < POLL_TIMEOUT)) || return 1
        sleep "$POLL_INTERVAL"
    done
}

file_result() { # path secs
    local path=$1 secs=$2 name=${1##*/}
    local result doc existing first
    result=$(jq -r '.[0].result // ""' <"$TMP_BODY")
    if [[ $TASK_STATUS == SUCCESS ]]; then
        doc=$(jq -r '.[0].related_document // empty' <"$TMP_BODY")
        file_into "$path" "done"
        touch "$DEST"
        log INFO success "file=\"$name\" doc=$doc secs=$secs"
        N_OK=$((N_OK + 1))
        if [[ $NOTIFY_SUCCESS == true ]]; then queue_notify "Uploaded" "$name → document #$doc" "" "$(doc_url "$doc")"; fi
    elif [[ $(jq -r '(.[0].duplicate_documents // []) | length' <"$TMP_BODY") -gt 0 ]] ||
        printf '%s' "$result" | grep -qi duplicate; then
        existing=$(jq -r '.[0].duplicate_documents[0].id // empty' <"$TMP_BODY")
        if [[ -z $existing ]]; then
            existing=$(printf '%s' "$result" | grep -Eo '#[0-9]+' | head -n 1 | tr -d '#' || true)
        fi
        file_into "$path" duplicates
        log WARN duplicate "file=\"$name\" existing=${existing:-unknown}"
        N_DUP=$((N_DUP + 1))
        queue_notify "Duplicate, skipped" "$name: already document #${existing:-unknown}" "" \
            "${existing:+$(doc_url "$existing")}"
    else
        first=${result%%$'\n'*}
        file_into "$path" failed
        printf '%s\n' "$result" >"$DEST.error"
        log ERROR failed "file=\"$name\" reason=\"$first\""
        N_FAIL=$((N_FAIL + 1))
        queue_notify "Error" "$name: $first" error "$(failed_url)"
    fi
}

is_network_error() { # curl-exit-code
    case $1 in 6 | 7 | 28) return 0 ;; esac
    return 1
}

fail_file() { # path error-text notify-text
    local path=$1 name=${1##*/}
    file_into "$path" failed
    printf '%s\n' "$2" >"$DEST.error"
    N_FAIL=$((N_FAIL + 1))
    queue_notify "Error" "$name: $3" error "$(failed_url)"
}

# Returns 1 when the run must stop (token rejected).
process_file() { # path
    local path=$1 name=${1##*/} task started=$SECONDS rc=0 base=$PAPERLESS_URL via=public body
    is_stable "$path" || return 0
    upload "$path" "$base" || rc=$?
    if is_network_error "$rc" && [[ -n $LAN_FALLBACK_URL ]]; then
        base=${LAN_FALLBACK_URL%/}
        via=lan
        rc=0
        upload "$path" "$base" || rc=$?
    fi
    if is_network_error "$rc"; then
        log WARN network_error "file=\"$name\" curl=$rc"
        if (($(date +%s) - $(stat -f %m "$path" 2>/dev/null || date +%s) > 3600)); then
            N_WAITING=$((N_WAITING + 1))
        fi
        return 0
    fi
    if ((rc != 0)) || [[ $HTTP_CODE != 2* ]]; then
        body=$(cat "$TMP_BODY")
        case $HTTP_CODE in
            401 | 403)
                log ERROR rejected "file=\"$name\" http=$HTTP_CODE"
                CONFIG_ERR="paperless rejected the API token (HTTP $HTTP_CODE); update PAPERLESS_TOKEN in $ENV_FILE"
                return 1
                ;;
            413)
                log ERROR failed "file=\"$name\" http=413"
                fail_file "$path" "too large for reverse proxy" "too large for the reverse proxy"
                ;;
            [45]??)
                log ERROR failed "file=\"$name\" http=$HTTP_CODE"
                body=${body:-HTTP $HTTP_CODE}
                fail_file "$path" "$body" "${body%%$'\n'*}"
                ;;
            *)
                # No HTTP answer (e.g. TLS error): not a final answer, retry on the next trigger.
                log WARN upload_error "file=\"$name\" reason=\"curl exit $rc, http=${HTTP_CODE:-none}\""
                ;;
        esac
        return 0
    fi
    task=$(jq -r 'if type == "string" then . else empty end' <"$TMP_BODY" 2>/dev/null || true)
    if [[ -z $task ]]; then
        log WARN upload_error "file=\"$name\" reason=\"no task id in response\""
        return 0
    fi
    log INFO uploaded "file=\"$name\" task=$task via=$via"
    if poll_task "$task" "$base"; then
        file_result "$path" "$((SECONDS - started))"
    else
        file_into "$path" pending
        printf '%s\n' "$task" >"$DEST.task"
        log WARN pending "file=\"$name\" task=$task"
    fi
}

recheck_pending() {
    local t file task age
    for t in "$SCAN_ROOT"/pending/*.task; do
        [[ -f $t ]] || continue
        file=${t%.task}
        if [[ ! -f $file ]]; then
            debug pending_orphan "task_file=\"${t##*/}\""
            rm -f "$t"
            continue
        fi
        task=$(head -n 1 "$t")
        age=$(($(date +%s) - $(stat -f %m "$t")))
        if api_get "$PAPERLESS_URL" "/api/tasks/?task_id=$task" && [[ $HTTP_CODE == 200 ]]; then
            TASK_STATUS=$(jq -r '.[0].status // empty' <"$TMP_BODY" 2>/dev/null || true)
        else
            continue
        fi
        case $TASK_STATUS in
            SUCCESS | FAILURE)
                file_result "$file" "$age"
                rm -f "$t"
                ;;
            *)
                if ((age > 86400)); then
                    log ERROR failed "file=\"${file##*/}\" reason=\"no result from paperless\""
                    fail_file "$file" "no result from paperless" "no result from paperless"
                    rm -f "$t"
                fi
                ;;
        esac
    done
}

delete_old_done() {
    local f
    while IFS= read -r -d '' f; do
        rm -f "$f"
        log INFO deleted "file=\"${f##*/}\""
    done < <(find "$SCAN_ROOT/done" -maxdepth 1 -type f -mtime "+$DONE_RETENTION_DAYS" -print0)
}

rotate_log() {
    local size n
    [[ -f $LOG ]] || return 0
    size=$(stat -f %z "$LOG")
    ((size > 5242880)) || return 0
    rm -f "$LOG.3"
    for n in 2 1; do
        if [[ -e $LOG.$n ]]; then mv "$LOG.$n" "$LOG.$((n + 1))"; fi
    done
    mv "$LOG" "$LOG.1"
}

selftest() {
    local fails=0 d dir rc=0

    pass() { printf 'ok    %s\n' "$1"; }
    fail() {
        printf 'FAIL  %s\n' "$1"
        fails=$((fails + 1))
    }

    for cmd in curl jq; do
        if command -v "$cmd" >/dev/null 2>&1; then pass "$cmd on PATH"; else fail "$cmd not on PATH"; fi
    done

    if load_env; then
        pass ".env valid, mode 600"
        if check_api_version; then pass "API_VERSION is 9"; else fail "$CONFIG_ERR"; fi
        dir=${ENV_FILE%/*}
        if command -v git >/dev/null 2>&1 && git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            fail ".env is inside a git working tree ($dir)"
        else
            pass ".env is outside any git working tree"
        fi

        ensure_dirs
        for d in $FOLDERS; do
            if [[ -w $SCAN_ROOT/$d ]]; then pass "$d/ writable"; else fail "$d/ not writable"; fi
        done

        api_get "$PAPERLESS_URL" "/api/tags/?page_size=1" || rc=$?
        if ((rc != 0)); then
            fail "server unreachable (curl exit $rc)"
        elif [[ $HTTP_CODE == 200 ]]; then
            pass "API reachable, token accepted"
        else
            fail "API answered HTTP $HTTP_CODE"
        fi
    else
        fail "$CONFIG_ERR"
    fi

    if ((fails == 0)); then
        echo "selftest passed"
    else
        echo "selftest failed: $fails problem(s)"
        return 1
    fi
}

health_cmd() {
    local out line d f problems=() n_failed=0 now body="" p mtime
    now=$(date +%s)
    out=$(selftest) || true
    while IFS= read -r line; do
        case $line in 'FAIL  '*) problems+=("${line#FAIL  }") ;; esac
    done <<<"$out"
    if ! agent_loaded; then problems+=("main agent not loaded"); fi
    n_failed=$(count_scans failed)
    if ((n_failed > 0)); then problems+=("$(plural "$n_failed" file) in failed/"); fi
    for f in "$SCAN_ROOT"/outbox/*; do
        is_scan_file "$f" || continue
        mtime=$(stat -f %m "$f" 2>/dev/null) || continue
        if ((now - mtime > 3600)); then problems+=("outbox file older than 1 h: ${f##*/}"); fi
    done
    if ((${#problems[@]} == 0)); then
        log INFO health ok
        return 0
    fi
    for p in "${problems[@]}"; do body+="${body:+; }$p"; done
    log WARN health "problems=${#problems[@]}"
    d="file://$LOG"
    if ((n_failed > 0)); then d=$(failed_url); fi
    notify "Health check" "$body" error "$d"
    return 1
}

acquire_lock() { # returns 1 when another run holds the lock
    local lock=$SCAN_ROOT/.lock pid=
    if ! mkdir "$lock" 2>/dev/null; then
        pid=$(cat "$lock/pid" 2>/dev/null || true)
        # The lock survives a reboot and pids get reused, so a live pid alone isn't proof.
        if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null &&
            [[ $(ps -p "$pid" -o command= 2>/dev/null) == *scan-intake* ]]; then
            log INFO skipped 'reason="another run in progress"'
            return 1
        fi
        log WARN stale_lock "pid=${pid:-none}"
        # Rename first so a run that takes over at the same time can't lose its new lock.
        mv "$lock" "$lock.stale.$$" 2>/dev/null && rm -rf "$lock.stale.$$"
        if ! mkdir "$lock" 2>/dev/null; then
            log INFO skipped 'reason="another run in progress"'
            return 1
        fi
    fi
    echo "$$" >"$lock/pid"
    LOCK_HELD=true
}

cleanup() {
    rm -f "$TMP_BODY"
    if [[ $LOCK_HELD == true ]]; then rm -rf "$SCAN_ROOT/.lock"; fi
}

agent_loaded() {
    launchctl print "gui/$(id -u)/$AGENT_LABEL" >/dev/null 2>&1
}

# Status reports problems instead of raising them: a bad .env is data, not an exit code.
load_config_quietly() { # sets CONFIG_ERR
    if load_env; then check_api_version || true; fi
}

count_scans() { # subdir
    local f n=0
    for f in "$SCAN_ROOT/$1"/*; do
        if is_scan_file "$f"; then n=$((n + 1)); fi
    done
    echo "$n"
}

failed_entries() { # one JSON object per line
    local f
    for f in "$SCAN_ROOT"/failed/*; do
        is_scan_file "$f" || continue
        jq -nc --arg file "${f##*/}" --arg error "$(head -n 1 "$f.error" 2>/dev/null || true)" \
            '{file: $file, error: $error}'
    done
}

pending_entries() { # one JSON object per line
    local t now mtime
    now=$(date +%s)
    for t in "$SCAN_ROOT"/pending/*.task; do
        [[ -f $t ]] || continue
        mtime=$(stat -f %m "$t" 2>/dev/null) || continue
        jq -nc --arg file "$(basename "$t" .task)" --arg task "$(head -n 1 "$t")" \
            --argjson age "$((now - mtime))" '{file: $file, task: $task, age_secs: $age}'
    done
}

status_cmd() { # [--json]
    local json=false loaded=false last_run="" last_success="" line at file doc
    local success_re='^([^ ]+) +INFO +success file="(.*)" doc=([0-9]+)'
    case ${1:-} in
        '') ;;
        --json) json=true ;;
        *)
            echo "usage: scan-intake status [--json]" >&2
            return 2
            ;;
    esac
    load_config_quietly
    if agent_loaded; then loaded=true; fi
    if [[ -f $LOG ]]; then
        line=$(grep ' run_start ' "$LOG" | tail -n 1 || true)
        last_run=${line%% *}
        line=$(grep -E ' INFO +success file=".*" doc=[0-9]+' "$LOG" | tail -n 1 || true)
        if [[ $line =~ $success_re ]]; then
            at=${BASH_REMATCH[1]} file=${BASH_REMATCH[2]} doc=${BASH_REMATCH[3]}
            last_success=$(jq -nc --arg file "$file" --argjson doc "$doc" --arg at "$at" \
                '{file: $file, doc: $doc, at: $at}')
        fi
    fi

    if [[ $json == true ]]; then
        jq -n \
            --arg err "$CONFIG_ERR" --argjson loaded "$loaded" --arg url "$PAPERLESS_URL" \
            --arg root "$SCAN_ROOT" --arg log "$LOG" \
            --argjson c_outbox "$(count_scans outbox)" --argjson c_pending "$(count_pending)" \
            --argjson c_failed "$(count_scans failed)" --argjson c_dups "$(count_scans duplicates)" \
            --argjson c_done "$(count_scans "done")" \
            --argjson failed "$(failed_entries | jq -s .)" --argjson pending "$(pending_entries | jq -s .)" \
            --arg last_run "$last_run" --argjson last_success "${last_success:-null}" '{
                config_ok: ($err == ""),
                config_error: (if $err == "" then null else $err end),
                agent_loaded: $loaded,
                paperless_url: $url,
                paths: {root: $root, outbox: "\($root)/outbox", pending: "\($root)/pending",
                        done: "\($root)/done", duplicates: "\($root)/duplicates",
                        failed: "\($root)/failed", log: $log},
                counts: {outbox: $c_outbox, pending: $c_pending, failed: $c_failed,
                         duplicates: $c_dups, done: $c_done},
                failed: $failed,
                pending: $pending,
                last_run: (if $last_run == "" then null else $last_run end),
                last_success: $last_success
            }'
        return 0
    fi

    if [[ -n $CONFIG_ERR ]]; then echo "config error: $CONFIG_ERR"; fi
    if [[ $loaded == false ]]; then echo "agent not loaded"; fi
    echo "outbox $(count_scans outbox), pending $(count_pending), failed $(count_scans failed)," \
        "duplicates $(count_scans duplicates), done $(count_scans "done")"
    if [[ -n $last_success ]]; then
        jq -r '"last success: \(.file) -> #\(.doc) at \(.at)"' <<<"$last_success"
    else
        echo "last success: none"
    fi
    failed_entries | jq -r '"failed: \(.file): \(.error)"'
}

retry_one() { # name -> 0, or 2 for an unusable name
    local name=$1
    if [[ -z $name || $name == */* || $name == *.error || ! -f $SCAN_ROOT/failed/$name ]]; then
        echo "scan-intake: not in failed/: $name" >&2
        return 2
    fi
    mkdir -p "$SCAN_ROOT/outbox"
    file_into "$SCAN_ROOT/failed/$name" outbox
    rm -f "$SCAN_ROOT/failed/$name.error"
    log INFO requeued "file=\"$name\""
    echo "requeued $name"
}

retry_cmd() { # file|all
    local f n=0
    if (($# != 1)); then
        echo "usage: scan-intake retry <file|all>" >&2
        return 2
    fi
    load_env || true
    if [[ $1 != all ]]; then
        retry_one "$1"
        return
    fi
    for f in "$SCAN_ROOT"/failed/*; do
        is_scan_file "$f" || continue
        retry_one "${f##*/}"
        n=$((n + 1))
    done
    if ((n == 0)); then echo "nothing to retry"; fi
}

# Scans saved during a run are missed by launchd's WatchPaths, so list outbox again
# (max 3 passes). A file is attempted once per run, which keeps an outage from
# multiplying upload attempts. Returns 1 when the run must stop (token rejected).
process_outbox() {
    local pass f name found attempted=$'\n'
    for ((pass = 0; pass < 3; pass++)); do
        found=false
        for f in "$SCAN_ROOT"/outbox/*; do
            is_scan_file "$f" || continue
            name=${f##*/}
            case $attempted in *$'\n'"$name"$'\n'*) continue ;; esac
            attempted+="$name"$'\n'
            found=true
            process_file "$f" || return 1
        done
        [[ $found == true ]] || break
    done
}

run_once() {
    local f rc=0
    if ! load_env; then
        config_error
        return 1
    fi
    check_api_version || {
        config_error
        return 1
    }
    ensure_dirs
    if [[ $DRY_RUN == false ]]; then acquire_lock || return 0; fi
    log INFO run_start "outbox=$(count_outbox) pending=$(count_pending)"

    if [[ $DRY_RUN == true ]]; then
        for f in "$SCAN_ROOT"/outbox/*; do
            if is_scan_file "$f"; then echo "would upload ${f##*/}"; fi
        done
        return 0
    fi

    recheck_pending
    process_outbox || rc=1
    flush_notifications
    if ((rc != 0)); then
        config_error
        return 1
    fi
    if ((N_WAITING > 0)); then
        notify "Waiting" "$(plural "$N_WAITING" scan) queued, paperless unreachable"
    fi
    delete_old_done
    rotate_log
}

main() {
    local arg
    case ${1:-} in
        health)
            shift
            MODE=health
            ;;
        status)
            shift
            status_cmd "$@"
            return
            ;;
        retry)
            shift
            retry_cmd "$@"
            return
            ;;
    esac
    for arg in "$@"; do
        case $arg in
            --once) MODE=once ;;
            --selftest) MODE=selftest ;;
            --dry-run) DRY_RUN=true ;;
            --verbose) VERBOSE=true ;;
            *)
                echo "usage: scan-intake [--once] [--selftest] [--dry-run] [--verbose] | status [--json] | retry <file|all> | health" >&2
                return 2
                ;;
        esac
    done

    TMP_BODY=$(mktemp "${TMPDIR:-/tmp}/scan-intake.XXXXXX")
    trap cleanup EXIT

    case $MODE in
        selftest) selftest ;;
        once) run_once ;;
        health) health_cmd ;;
    esac
}

main "$@"
