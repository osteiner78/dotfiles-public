# Paste the token from the paperless web UI: My Profile -> API Auth Token.
PAPERLESS_TOKEN=
PAPERLESS_URL=https://paperless.osteiner.xyz
# API_VERSION must stay 9: with 10 the task API changes and every upload times out.
API_VERSION=9
POLL_TIMEOUT=300
POLL_INTERVAL=5
STABLE_SECS=5
DONE_RETENTION_DAYS=180
NOTIFY_SUCCESS=true
# Optional, e.g. http://192.168.1.206:8000. Used only when the public URL is unreachable.
LAN_FALLBACK_URL=
# SCAN_ROOT defaults to ~/Scans. The LaunchAgent watches ~/Scans/outbox, so
# overriding it also means editing the plist.
