#!/usr/bin/env python3
"""Render the compiled Karabiner config as an HTML cheatsheet.

Reads ~/.config/karabiner/karabiner.json (goku output) and uses
~/.config/karabiner.edn only to map bundle-id regexes and device ids back to
the alias names. Usage: karabiner-cheatsheet-gen [out.html]  (default: stdout)
"""
import html
import json
import os
import re
import sys
import time

JSON_PATH = os.path.expanduser("~/.config/karabiner/karabiner.json")
EDN_PATH = os.path.expanduser("~/.config/karabiner.edn")

MODS = {
    "left_control": "⌃", "right_control": "⌃ʳ",
    "left_option": "⌥", "right_option": "⌥ʳ",
    "left_shift": "⇧", "right_shift": "⇧ʳ",
    "left_command": "⌘", "right_command": "⌘ʳ",
    "fn": "fn+", "caps_lock": "⇪",
}
MOD_ORDER = list(MODS)
KEYS = {
    "return_or_enter": "↩", "spacebar": "space", "grave_accent_and_tilde": "`",
    "open_bracket": "[", "close_bracket": "]", "backslash": "\\", "slash": "/",
    "equal_sign": "=", "period": ".", "comma": ",", "tab": "⇥", "escape": "esc",
    "left_arrow": "←", "right_arrow": "→", "up_arrow": "↑", "down_arrow": "↓",
    "page_up": "pgup", "page_down": "pgdn", "caps_lock": "caps",
    "left_command": "left ⌘", "right_command": "right ⌘",
    "left_control": "left ⌃", "right_control": "right ⌃",
    "left_option": "left ⌥", "right_option": "right ⌥",
    "left_shift": "left ⇧", "right_shift": "right ⇧",
}


def read_edn_aliases():
    apps, devices = {}, {}
    try:
        text = open(EDN_PATH, encoding="utf-8").read()
    except OSError:
        return apps, devices
    text = re.sub(r"(?m)^\s*;.*$", "", text)
    block = re.search(r":applications\s*\{(.*?)\n\}", text, re.S)
    if block:
        for name, pats in re.findall(r":(\S+)\s+\[(.*?)\]", block.group(1), re.S):
            for pat in re.findall(r'"((?:[^"\\]|\\.)*)"', pats):
                apps[pat.replace("\\\\", "\\")] = name
    block = re.search(r":devices\s*\{(.*?)\n\}", text, re.S)
    if block:
        for name, vid, pid in re.findall(
            r":([\w-]+)\s+\[\{:vendor_id (\d+) :product_id (\d+)\}\]", block.group(1)
        ):
            devices[(int(vid), int(pid))] = name
    return apps, devices


def fmt_mods(mods):
    return "".join(MODS.get(m, m) for m in sorted(mods, key=MOD_ORDER.index))


def fmt_key(key, mods=()):
    label = KEYS.get(key, key.upper() if len(key) == 1 else key)
    return fmt_mods(mods) + label


def shorten_app(arg):
    arg = arg.strip().strip("\"'").replace("'", "")
    name = os.path.basename(arg)
    return name[:-4] if name.endswith(".app") else name


def fmt_shell(cmd):
    if "show-karabiner-cheatsheet" in cmd:
        return "this cheatsheet"
    m = re.search(r'shortcuts run "([^"]+)"', cmd)
    if m:
        return m.group(1).lower()
    m = re.search(r'launch-focus --app "([^"]+)"', cmd)
    if m:
        return "focus " + m.group(1)
    m = re.search(r'launch-focus --bundle-id "([^"]+)"', cmd)
    if m:
        return "focus " + m.group(1).split(".")[-1]
    m = re.search(r"open -n -a (.+)$", cmd)
    if m:
        return "new " + shorten_app(m.group(1))
    m = re.search(r"open -a (.+)$", cmd)
    if m:
        return "open " + shorten_app(m.group(1))
    return cmd[:60]


def fmt_to(items):
    parts = []
    for item in items:
        if "key_code" in item:
            parts.append(fmt_key(item["key_code"], item.get("modifiers", ())))
        elif "shell_command" in item:
            parts.append(fmt_shell(item["shell_command"]))
    return " ".join(parts)


def fmt_from(frm):
    mods = frm.get("modifiers", {}).get("mandatory", ())
    return fmt_key(frm["key_code"], mods)


def context(conds, apps, devices):
    out = []
    for cond in conds:
        if cond["type"] == "frontmost_application_if":
            names = [apps.get(b, b) for b in cond["bundle_identifiers"]]
            out.append(", ".join(dict.fromkeys(names)))
        elif cond["type"] == "device_if":
            out.append(", ".join(
                devices.get((i.get("vendor_id"), i.get("product_id")), "device")
                for i in cond["identifiers"]
            ))
    return " · ".join(out)


def rows_for(rule, apps, devices):
    rows = []
    for m in rule["manipulators"]:
        conds = m.get("conditions", [])
        layers = [c["name"] for c in conds if c["type"] == "variable_if"]
        to = m.get("to", [])
        setter = next((t["set_variable"] for t in to if "set_variable" in t), None)
        alone = fmt_to(m.get("to_if_alone", []))
        key = fmt_from(m["from"])
        if setter:
            action = "hold: %s layer" % setter["name"]
            if alone:
                action += " · tap: " + alone
            rows.append((key, action, ""))
            continue
        if layers:
            key = "⇪ " + key
        passthrough = alone and to and to[0].get("key_code") == m["from"]["key_code"]
        action = "tap: " + alone if passthrough else fmt_to(to)
        rows.append((key, action, context(conds, apps, devices)))
    keys = [r[0] for r in rows]
    return [
        (k, a, c or ("other apps" if keys.count(k) > 1 else ""))
        for k, a, c in rows
    ]


CSS = """
:root{--fg:#111;--muted:#666;--bg:#fff;--card:#f7f7f7;--accent:#222}
@media (prefers-color-scheme:dark){:root{--fg:#eaeaea;--muted:#a0a0a0;--bg:#0e0e0f;--card:#161618;--accent:#eaeaea}}
html,body{margin:0;padding:0;background:var(--bg);color:var(--fg);font:13px/1.35 -apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif}
.wrap{max-width:700px;margin:18px auto 28px;padding:0 14px}
header{display:flex;align-items:baseline;gap:14px;margin-bottom:10px}
h1{font-size:18px;margin:0}
.muted{color:var(--muted);font-size:12px}
.columns{column-count:2;column-gap:18px}
.section{break-inside:avoid;margin:0 0 14px;padding:10px 12px;background:var(--card);border-radius:10px}
.section>h2{font-size:13px;margin:0 0 8px;color:var(--accent)}
.row{display:flex;gap:8px;padding:2px 0;align-items:baseline}
.key{white-space:nowrap;min-width:64px}
code.k{padding:1px 6px;border-radius:6px;background:rgba(127,127,127,.15);font-weight:600}
.act{flex:1}
.ctx{color:var(--muted);font-size:11px;white-space:nowrap}
"""


def render():
    data = json.load(open(JSON_PATH, encoding="utf-8"))
    profile = next((p for p in data["profiles"] if p.get("selected")), data["profiles"][0])
    apps, devices = read_edn_aliases()
    sections = []
    for rule in profile["complex_modifications"]["rules"]:
        rows = rows_for(rule, apps, devices)
        title = rule["description"]
        if title.startswith("Auto generated layer"):
            title = "Layers"
        body = "".join(
            '<div class="row"><div class="key"><code class="k">%s</code></div>'
            '<div class="act">%s</div><div class="ctx">%s</div></div>'
            % (html.escape(k), html.escape(a), html.escape(c))
            for k, a, c in rows
        )
        sections.append('<div class="section"><h2>%s</h2>%s</div>' % (html.escape(title), body))
    stamp = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(JSON_PATH)))
    return (
        '<!doctype html><meta charset="utf-8"><title>Karabiner Cheatsheet</title>'
        "<style>%s</style><div class=\"wrap\"><header><h1>Karabiner Keybinds</h1>"
        '<div class="muted">⇪ = hold caps (hyper) · ʳ = right-side key · generated from karabiner.json (%s)</div>'
        '</header><div class="columns">%s</div></div>' % (CSS, stamp, "".join(sections))
    )


if __name__ == "__main__":
    out = render()
    if len(sys.argv) > 1:
        with open(sys.argv[1], "w", encoding="utf-8") as f:
            f.write(out)
    else:
        sys.stdout.write(out)
